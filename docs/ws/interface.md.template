## 6. FE 연동 예시

`@stomp/stompjs` 7.x를 사용합니다.

```bash
npm install @stomp/stompjs
```

### 6-1. 공통 연결 (`stompClient.ts`)

<!-- [공통] -->

모든 토픽이 연결 하나를 같이 씁니다. 다른 토픽 문서에서 이미 만들었다면 그대로 재사용합니다.

```tsx
import { Client, IMessage } from '@stomp/stompjs';

/** 모든 토픽 메시지의 공통 형식. */
export type TopicEnvelope<T> = {
  type: string;
  payload: T;
  publishedAt: string;
};

export const stompClient = new Client({
  brokerURL: import.meta.env.VITE_WS_URL, // 로컬: ws://localhost:8080/ws, 운영: wss://api.naspi.my/ws
  heartbeatIncoming: 10000,
  heartbeatOutgoing: 10000,
  reconnectDelay: 3000, // 끊기면 3초 뒤 다시 연결
});

/** 구독 중인 토픽. 다시 연결되면 모두 다시 구독한다. */
const topics = new Map<string, (frame: IMessage) => void>();

stompClient.onConnect = () => {
  topics.forEach((handler, destination) =>
    stompClient.subscribe(destination, handler, { id: destination }),
  );
};

// 구독 권한 없음 등. 서버가 곧 연결을 끊고, reconnectDelay 뒤 다시 연결한다.
stompClient.onStompError = (frame) => {
  console.error('STOMP ERROR:', frame.headers.message);
};

// 핸드셰이크 실패(401 등)도 여기로 온다. 상태 코드는 알 수 없으므로 필요하면 REST로 로그인 상태를 확인한다.
stompClient.onWebSocketClose = (event) => {
  console.warn('WebSocket 연결 종료:', event.code);
};

/**
 * 토픽을 구독한다. 반환된 함수를 호출하면 구독을 해지한다.
 * 같은 경로는 한 곳에서만 구독한다고 가정한다.
 */
export function subscribeTopic<T>(
  destination: string,
  onMessage: (payload: T, envelope: TopicEnvelope<T>) => void,
): () => void {
  let lastPublishedAt = 0;
  const handler = (frame: IMessage) => {
    const envelope: TopicEnvelope<T> = JSON.parse(frame.body);
    const publishedAt = Date.parse(envelope.publishedAt); // 오프셋이 없어 브라우저 시간대로 해석되지만 비교에는 문제없다
    if (publishedAt < lastPublishedAt) return; // 늦게 도착한 이전 메시지는 버린다
    lastPublishedAt = publishedAt;
    onMessage(envelope.payload, envelope);
  };

  topics.set(destination, handler);
  if (stompClient.connected) {
    stompClient.subscribe(destination, handler, { id: destination });
  }
  if (!stompClient.active) {
    stompClient.activate();
  }

  return () => {
    topics.delete(destination);
    if (stompClient.connected) {
      stompClient.unsubscribe(destination);
    }
    if (topics.size === 0) {
      void stompClient.deactivate();
    }
  };
}
```

### 6-2. {{토픽 이름}} 구독

<!-- 타입은 3장 payload 표와 필드를 맞춘다 (Long → number, 시각 → string, enum → 문자열 리터럴 유니언). 배열 필드에는 정렬 기준을 주석으로 단다. -->

```tsx
import { useEffect, useState } from 'react';
import { subscribeTopic } from './stompClient';

export type {{Item}} = {
  {{field}}: number;
};

export type {{Payload}} = {
  {{field}}: number;
  {{enumField}}: '{{VALUE_A}}' | '{{VALUE_B}}';
  {{list}}: {{Item}}[]; // {{정렬 기준}}
};
```

<!-- [A/B] A: 덮어쓰기 -->

```tsx
/** {{무엇을 받는지}}. */
export function use{{Xxx}}({{leagueId}}: number) {
  const [value, setValue] = useState<{{Payload}} | null>(null);

  useEffect(
    () => subscribeTopic<{{Payload}}>(`/topic/{{경로}}`, setValue),
    [{{leagueId}}],
  );

  return value;
}
```

<!-- [A/B] B: 합치기 -->

```tsx
/** 같은 {{키 필드}}면 덮어쓰고, 없으면 뒤에 추가한다. */
function merge(current: {{Item}}[], recent: {{Item}}[]): {{Item}}[] {
  const merged = [...current];
  for (const item of recent) {
    const index = merged.findIndex((c) => c.{{키 필드}} === item.{{키 필드}});
    if (index >= 0) merged[index] = item;
    else merged.push(item);
  }
  return merged;
}

/** {{무엇을 받는지}}. initialItems는 처음 접속할 때 REST로 받은 값이다. */
export function use{{Xxx}}({{leagueId}}: number, initialItems: {{Item}}[] = []) {
  const [items, setItems] = useState<{{Item}}[]>(initialItems);

  useEffect(() => {
    setItems(initialItems);
    return subscribeTopic<{{Payload}}>(`/topic/{{경로}}`, (payload) =>
      setItems((prev) => merge(prev, payload.{{list}})),
    );
  }, [{{leagueId}}, initialItems]);

  return items;
}
```

> `initialItems`는 렌더링마다 새 배열을 만들지 않도록 `useMemo`나 상태로 넘깁니다. 매번 새 배열이면 구독을 계속 다시 합니다.

<!-- [선택] 화면 예시. 3장 "메시지 처리 방법"의 그리는 법·프론트 계산 값을 코드로 보여 준다. -->

```tsx
function {{Xxx}}View({ {{leagueId}} }: { {{leagueId}}: number }) {
  const value = use{{Xxx}}({{leagueId}});
  if (!value) return null;

  return <div>{{화면 예시}}</div>;
}
```
